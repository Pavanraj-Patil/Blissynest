# Copy this file to .env (or .env.local) and fill in real values.
# .env/.env.local are gitignored — never commit real secrets.

# --- Database (MySQL, on the same Hostinger plan as the app) ---------------
# From hPanel → Databases → your MySQL database → connection details.
DATABASE_URL="mysql://user:password@host:3306/dbname"

# --- Shipping (Shiprocket) ---------------------------------------------------
# Shiprocket account email/password (not an API key — Shiprocket's API
# trades these for a bearer token). Until both are set, order placement
# silently skips shipment creation — see src/lib/shiprocket.ts.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# The pickup location name exactly as configured in Shiprocket's dashboard
# (Settings → Pickup Addresses). Defaults to "Primary" if unset.
SHIPROCKET_PICKUP_LOCATION="Primary"

# --- Auth (NextAuth v5) -----------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorized redirect URI: <your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments (Razorpay) -----------------------------------------------------
# Razorpay Dashboard → Settings → API Keys. Test-mode keys work immediately
# after signup, no business verification needed to start testing. Until both
# are set, card/UPI/net-banking checkout shows an inline error asking the
# customer to use Cash on Delivery instead — see src/lib/razorpay.ts.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Razorpay Dashboard → Settings → Webhooks → the secret you set there.
# Webhook URL to configure there: <your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# --- Images (Cloudflare R2 + Cloudflare Images) -------------------------------
# Active image backend — see src/app/api/admin/upload-image-r2/route.ts.
# R2_ACCOUNT_ID / CLOUDFLARE_IMAGES_ACCOUNT_HASH are different values, both
# from the Cloudflare dashboard (Account Home / Images → the "Account Hash"
# under Image Delivery URL). R2_PUBLIC_URL is the bucket's public dev URL
# (R2 → your bucket → Settings → Public Access) or a custom domain — it must
# be reachable from the public internet, since Cloudflare Images fetches
# from it directly rather than via the S3 credentials below. Flexible
# variants must be turned on once under Images → Variants for the
# w=,quality=,format= URL syntax the custom loader uses to work.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
CLOUDFLARE_IMAGES_ACCOUNT_HASH=""
CLOUDFLARE_IMAGES_API_TOKEN=""

# --- Images (Cloudinary) — kept as a working fallback/revert path -------------
# See src/app/api/admin/upload-image/route.ts. Not the active path (see
# above) unless the two ImageUploader components are pointed back at
# /api/admin/upload-image instead of /api/admin/upload-image-r2.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (only needed once order-confirmation/contact-form emails are wired up) ---
RESEND_API_KEY=""
EMAIL_FROM="Blissynest <onboarding@resend.dev>"
