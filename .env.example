# Copy this file to .env (or .env.local) and fill in real values.
# .env/.env.local are gitignored — never commit real secrets.

# --- Database (MySQL, on the same Hostinger plan as the app) ---------------
# From hPanel → Databases → your MySQL database → connection details.
DATABASE_URL="mysql://user:password@host:3306/dbname"

# --- Shipping (Shiprocket) ---------------------------------------------------
# Shiprocket account email/password (not an API key — Shiprocket's API
# trades these for a bearer token). Until both are set, order placement
# silently skips shipment creation — see src/lib/shiprocket.ts.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# The pickup location name exactly as configured in Shiprocket's dashboard
# (Settings → Pickup Addresses). Defaults to "Primary" if unset.
SHIPROCKET_PICKUP_LOCATION="Primary"

# --- Auth (NextAuth v5) -----------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorized redirect URI: <your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments (Razorpay) -----------------------------------------------------
# Razorpay Dashboard → Settings → API Keys. Test-mode keys work immediately
# after signup, no business verification needed to start testing. Until both
# are set, card/UPI/net-banking checkout shows an inline error asking the
# customer to use Cash on Delivery instead — see src/lib/razorpay.ts.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Razorpay Dashboard → Settings → Webhooks → the secret you set there.
# Webhook URL to configure there: <your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# --- Images (Cloudflare R2) ---------------------------------------------------
# Active image backend — see src/app/api/admin/upload-image-r2/route.ts.
# Product photos and shoppers' own uploaded photos are stored in an R2 bucket.
# R2_PUBLIC_URL is where that bucket is publicly readable: use a custom
# domain on your Cloudflare zone (e.g. https://images.yourdomain.com — R2 →
# bucket → Settings → Custom Domains). The r2.dev URL works for testing but
# is rate-limited and not meant for production.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
# Set to "true" ONLY once the site's domain is proxied through Cloudflare and
# Image Transformations is enabled for that zone (Images → Transformations).
# It makes R2 photos resize at Cloudflare's edge (free up to 5,000 unique
# transforms/month). Leave empty locally: /cdn-cgi/image doesn't exist on
# localhost, so photos are resized by this app's own /api/image-proxy instead.
CLOUDFLARE_IMAGE_TRANSFORMS=""

# --- Images (Cloudinary) — kept as a working fallback/revert path -------------
# See src/app/api/admin/upload-image/route.ts. Not the active path (see
# above) unless the two ImageUploader components are pointed back at
# /api/admin/upload-image instead of /api/admin/upload-image-r2.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email: order confirmations, shipping updates, password reset ---
# Without a provider configured, emails are NOT sent; they are printed to the
# server console instead (handy locally). EMAIL_FROM must be an address on a
# domain you have verified with the provider.
#
# Option 1 (recommended): ZeptoMail. Use the "Send Mail Token" from your
# ZeptoMail agent, and the region your ZeptoMail account is in:
# in (India, default), com (US), eu, com.au, jp, ca, sa.
ZEPTOMAIL_TOKEN=""
ZEPTOMAIL_REGION="in"
# Option 2: Resend. Only used when ZEPTOMAIL_TOKEN is empty.
RESEND_API_KEY=""
EMAIL_FROM="Blissynest <orders@your-domain.com>"
# Where internal notifications go (new order / contact message / corporate
# lead). Defaults to the support email in Admin -> Site Content -> Legal & Business.
TEAM_NOTIFY_EMAIL=""

# --- Public site address & search engines --------------------------------------
# The live site's origin (no trailing slash). Used for canonical links, the
# sitemap, share cards and the links inside emails (password reset etc.).
NEXT_PUBLIC_SITE_URL="https://blissynest.com"
# Set to "true" ONLY on the live production site. Anywhere else (localhost, the
# UAT tunnel) leave it unset so Google is told not to index the copy.
ALLOW_SEARCH_INDEXING=""
