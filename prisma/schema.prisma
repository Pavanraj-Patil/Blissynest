generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  tagline             String?
  pdpType             PdpType          @default(STANDALONE)
  audience            Json // Audience[] — string[] of Audience enum values, see prisma/schema history re: MySQL has no native array column
  category            Json // string[] of shopCategories slugs
  collectionSlug      String?
  occasionTags        Json
  recipientTags       Json
  basePrice           Int
  compareAtPrice      Int?
  images              Json
  breadcrumbCategory  String?
  inStock             Boolean          @default(true)
  stockQuantity       Int              @default(0)
  // Lets an admin exclude a specific product from Cash on Delivery (e.g.
  // high-value or easily-misused items) even while COD stays enabled
  // site-wide (SiteSettings.codEnabled).
  codAvailable        Boolean          @default(true)
  rating              Float            @default(0)
  reviewCount         Int              @default(0)
  benefits            Json?
  productDetails      Json
  whatsInside         Json?
  personalNoteLabel   String?
  personalNotePrice   Int?
  customizationSchema Json?
  variants            Json?
  // Standalone-only: per-variant-option image overrides, keyed by
  // "<variant label>::<option>" (e.g. "Color::Black"). A gallery falls back
  // to `images` for any option with no entry here.
  variantImages       Json?
  relatedSlugs        Json
  featured            Boolean          @default(false)
  // When true, hidden from every consumer-facing browse/search surface
  // (Shop, audience pages, Collections, Occasions, Personalised, search,
  // homepage featured carousel) — only shown on its corporateNeeds page(s)
  // under /corporate/[need]. Still has a normal PDP and is normally
  // purchasable if reached directly.
  corporateOnly       Boolean          @default(false)
  corporateNeeds      Json // string[] of corporate-need slugs (see corporateNeedSlugs in corporate-data.ts) — only meaningful when corporateOnly is true
  status              ProductStatus    @default(PUBLISHED)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  attribute           String?
  badge               ProductBadge?
  sortRank            Int?
  cartItems           CartItem[]
  orderItems          OrderItem[]
  restockRequests     RestockRequest[]
  reviews             Review[]
  wishlistedBy        Wishlist[]

  @@index([collectionSlug])
  @@index([featured])
  @@index([status])
}

model User {
  id               String     @id @default(cuid())
  name             String?
  email            String     @unique
  emailVerified    DateTime?
  phone            String?
  image            String?
  passwordHash     String?
  role             UserRole   @default(CUSTOMER)
  // Delegable admin capabilities (see src/lib/admin/permissions.ts) —
  // string[] of AdminPermission keys. Only meaningful when role=ADMIN;
  // SUPER_ADMIN implicitly holds every permission (never reads this field)
  // and CUSTOMER never reads it either. Not itself a grantable permission —
  // admin management is exclusively a super-admin capability, so an ADMIN
  // can never escalate their own or anyone else's access.
  adminPermissions Json       @default("[]")
  twoFactorSecret  String?
  twoFactorEnabled Boolean    @default(false)
  // Account settings notification toggles — surfaced on the account
  // Settings tab. Plain booleans rather than JSON since the set of
  // toggles is small and fixed.
  notifyOrders     Boolean    @default(true)
  notifyPromos     Boolean    @default(true)
  notifyRecs       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  accounts         Account[]
  addresses        Address[]
  cart             Cart?
  orders           Order[]
  reviews          Review[]
  sessions         Session[]
  wishlist         Wishlist[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  name      String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  quantity      Int
  customization Json?
  createdAt     DateTime @default(now())
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  userId            String?
  status            OrderStatus       @default(PLACED)
  shippingAddress   Json
  buyerName         String
  buyerPhone        String
  buyerEmail        String
  isGift            Boolean           @default(false)
  giftNote          String?           @db.Text
  hidePricesOnSlip  Boolean           @default(false)
  subtotal          Int
  discount          Int               @default(0)
  couponCode        String?
  shippingCost      Int
  gstAmount         Int               @default(0)
  total             Int
  paymentMethod     PaymentMethodType @default(CARD)
  paymentStatus     PaymentStatus     @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  codOutcome        CodOutcome?
  trackingNumber    String?
  carrierName       String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime          @default(now())
  user              User?             @relation(fields: [userId], references: [id])
  items             OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  productName   String
  productImage  String
  quantity      Int
  unitPrice     Int
  customization Json?
  order         Order    @relation(fields: [orderId], references: [id])
  product       Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  minOrderValue Int          @default(0)
  usageLimit    Int?
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  userId      String?
  orderId     String?
  rating      Int
  comment     String       @db.Text
  photos      Json
  status      ReviewStatus @default(PENDING)
  sellerReply String?      @db.Text
  createdAt   DateTime     @default(now())
  authorName  String?
  product     Product      @relation(fields: [productId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@index([userId])
  @@index([status])
}

model CorporateLead {
  id                  String     @id @default(cuid())
  name                String
  workEmail           String
  phone               String
  companyName         String
  teamSize            String?
  interest            String?
  intent              LeadIntent @default(QUOTE)
  message             String?    @db.Text
  downloadedCatalogue Boolean    @default(false)
  status              LeadStatus @default(NEW)
  createdAt           DateTime   @default(now())

  @@index([status])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model RestockRequest {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  productId String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String
  href        String
  icon        String
  gradient    String
  // Optional photo — when set, the carousel shows this behind a scrim
  // instead of the solid gradient + ghost icon. A single wide desktop crop
  // stretched across a phone-width viewport loses the subject (same issue
  // Hero.tsx solves for the main hero image), so imageMobile is a separate
  // art-directed crop for narrow viewports — falls back to `image` when unset.
  image       String?
  imageMobile String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model SiteSettings {
  id                    String   @id @default("singleton")
  gstRatePercent        Int      @default(0)
  freeShippingThreshold Int      @default(99900)
  standardShippingFee   Int      @default(9900)
  // Store-wide Cash on Delivery kill switch. A product can also be excluded
  // individually via Product.codAvailable, independent of this flag.
  codEnabled            Boolean  @default(true)
  // Shows/hides the top strip (free-shipping banner + Track Order/Help/
  // Corporate Gifting links) across every page.
  topBarEnabled         Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model ContentBlock {
  id        String           @id @default(cuid())
  page      String
  section   String
  key       String
  type      ContentBlockType
  value     Json
  updatedAt DateTime         @updatedAt

  @@unique([page, section, key])
  @@index([page])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  changes     Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([targetType, targetId])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

enum PdpType {
  HAMPER
  CUSTOMISABLE
  STANDALONE
}

enum Audience {
  HER
  HIM
  PARENTS
  COUPLES
  KIDS
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductBadge {
  BESTSELLER
  NEW
}

enum UserRole {
  CUSTOMER
  ADMIN
  // Full, unscoped access — the only role that can manage other admins'
  // roles/permissions (see requireSuperAdmin in src/lib/admin/require-admin.ts).
  // A plain ADMIN's actual access is whatever's in their adminPermissions.
  SUPER_ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethodType {
  CARD
  UPI
  NETBANKING
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CodOutcome {
  DELIVERED
  RTO
}

enum DiscountType {
  PERCENT
  FLAT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadIntent {
  QUOTE
  CONSULTATION
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}

enum ContentBlockType {
  TEXT
  IMAGE
  IMAGE_RESPONSIVE
  ICON
  LINK
  LIST
  NESTED_LIST
}
